<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Admin data cleanup | MessAudit</title>
    <link rel="stylesheet" href="${pageContext.request.contextPath}/dashboard.css?v=20261029-coral-navy">
</head>
<body>
    <%@ include file="fragments/app-chrome.jspf" %>
    <main class="page-shell admin-page">
        <section class="page-heading" aria-labelledby="page-title">
            <div><p class="eyebrow">Administrator workspace</p><h1 id="page-title">Data cleanup</h1>
                <p class="intro">Review one record at a time. Dependency checks determine which safe action, if any, is available.</p></div>
            <a class="button button-secondary" href="${pageContext.request.contextPath}/admin/data-management?section=<c:out value='${adminSection}' />">Back to management</a>
        </section>
        <c:if test="${not empty successMessage}"><div class="notice notice-success" role="status"><c:out value="${successMessage}" /></div></c:if>
        <c:if test="${not empty adminError}"><div class="notice notice-error" role="alert"><c:out value="${adminError}" /></div></c:if>

        <nav class="admin-category-nav cleanup-category-nav" aria-label="Cleanup categories">
            <a href="${pageContext.request.contextPath}/admin/data-cleanup?section=orders" class="${adminSection eq 'orders' ? 'is-selected' : ''}" aria-current="${adminSection eq 'orders' ? 'page' : 'false'}">Purchase Orders</a>
            <a href="${pageContext.request.contextPath}/admin/data-cleanup?section=receipts" class="${adminSection eq 'receipts' ? 'is-selected' : ''}" aria-current="${adminSection eq 'receipts' ? 'page' : 'false'}">Goods Receipts</a>
            <a href="${pageContext.request.contextPath}/admin/data-cleanup?section=daily" class="${adminSection eq 'daily' ? 'is-selected' : ''}" aria-current="${adminSection eq 'daily' ? 'page' : 'false'}">Daily Mess Records</a>
        </nav>
        <form class="reference-search-form admin-search admin-category-search" action="${pageContext.request.contextPath}/admin/data-cleanup" method="get">
            <input type="hidden" name="section" value="<c:out value='${adminSection}' />"><div class="form-field"><label for="cleanup-search">Search within <c:out value="${adminSectionLabel}" /></label><input id="cleanup-search" name="q" type="search" maxlength="80" value="<c:out value='${adminSearch}' />" autocomplete="off" placeholder="<c:out value='${adminSearchPlaceholder}' />" data-admin-search-input></div>
            <div class="reference-search-actions"><button class="button button-primary" type="submit">Search</button><a class="button button-secondary" href="${pageContext.request.contextPath}/admin/data-cleanup?section=<c:out value='${adminSection}' />">Clear</a></div><p class="filter-count" aria-live="polite" data-admin-search-status></p>
        </form>
        <p class="panel-note">Only the selected category is loaded. Lists show at most 40 recent records; search does not change database rows.</p>
        <section class="notice notice-warning cleanup-policy" role="note" aria-labelledby="cleanup-policy-title">
            <h2 id="cleanup-policy-title">Demo and test data is reviewed one record at a time</h2>
            <p>The current schema has no reliable field marking existing rows as demo data. MessAudit will not guess which records are safe to remove and provides no bulk-cleanup action. Select an individual record below to review its identifiers, dependencies, and allowed action before confirming. A separate migration to mark future demo rows is not needed for this safe workflow.</p>
        </section>

        <c:if test="${adminSection eq 'orders'}">
        <section class="panel admin-section" id="orders" aria-labelledby="orders-title" data-admin-search-scope>
            <div class="panel-heading"><div><p class="eyebrow">Individual review</p><h2 id="orders-title">Purchase orders</h2></div></div>
            <p class="panel-note">Order items may be deleted only in the same transaction as an unreceived order with no receipt, penalty-review, or existing audit history. Open or partial orders with history may be cancelled instead; cancellation preserves the order and receipt evidence.</p>
            <div class="table-wrap"><table class="admin-table"><thead><tr><th>Order</th><th>Vendor</th><th>Block</th><th>Date</th><th>Status</th><th>Items</th><th>Receipts</th><th>Reviews</th><th>Audit entries</th><th>Review</th></tr></thead><tbody>
                <c:forEach items="${adminOrders}" var="row"><tr><td><strong><c:out value="${row.po_number}" /></strong></td><td><c:out value="${row.vendor_name}" /></td><td><c:out value="${row.block_name}" /></td><td><fmt:formatDate value="${row.ordered_at}" pattern="yyyy-MM-dd" /></td><td><span class="status-chip"><c:out value="${row.status}" /></span></td><td><c:out value="${row.item_count}" /></td><td><c:out value="${row.receipt_count}" /></td><td><c:out value="${row.review_count}" /></td><td><c:out value="${row.audit_count}" /></td><td><a href="${pageContext.request.contextPath}/admin/data-cleanup?section=orders&orderId=${row.po_id}#order-review">Review record</a></td></tr></c:forEach>
                <c:if test="${empty adminOrders}"><tr><td colspan="10" class="empty-cell">No orders match this search.</td></tr></c:if>
            </tbody></table></div>
            <c:choose><c:when test="${not empty selectedOrder}">
                <div class="admin-review-card" id="order-review">
                    <div class="panel-heading"><div><p class="eyebrow">Selected record</p><h3><c:out value="${selectedOrder.po_number}" /> · <c:out value="${selectedOrder.status}" /></h3></div><span class="unit-tag">Order ID <c:out value="${selectedOrder.po_id}" /></span></div>
                    <dl class="admin-detail-facts"><div><dt>Vendor</dt><dd><c:out value="${selectedOrder.vendor_name}" /></dd></div><div><dt>Mess block</dt><dd><c:out value="${selectedOrder.block_name}" /></dd></div><div><dt>Order items</dt><dd><c:out value="${selectedOrder.item_count}" /></dd></div><div><dt>Receipts</dt><dd><c:out value="${selectedOrder.receipt_count}" /></dd></div><div><dt>Penalty reviews</dt><dd><c:out value="${selectedOrder.review_count}" /></dd></div><div><dt>Audit history</dt><dd><c:out value="${selectedOrder.audit_count}" /></dd></div></dl>
                    <div class="table-wrap"><table class="admin-table"><thead><tr><th>Ingredient</th><th>Ordered</th><th>Received</th><th>Accepted</th><th>Rejected</th></tr></thead><tbody><c:forEach items="${selectedOrderItems}" var="line"><tr><td><c:out value="${line.ingredient_name}" /> (<c:out value="${line.base_unit}" />)</td><td><c:out value="${line.ordered_qty}" /></td><td><c:out value="${line.received_qty}" /></td><td><c:out value="${line.accepted_qty}" /></td><td><c:out value="${line.rejected_qty}" /></td></tr></c:forEach></tbody></table></div>
                    <c:if test="${selectedOrder.receipt_count eq 0 and selectedOrder.review_count eq 0 and selectedOrder.audit_count eq 0}">
                        <form class="delete-confirmation cleanup-action-form" action="${pageContext.request.contextPath}/admin/data-cleanup" method="post">
                            <input type="hidden" name="_csrf" value="<c:out value='${csrfToken}' />"><input type="hidden" name="section" value="<c:out value='${adminSection}' />"><input type="hidden" name="action" value="delete-order"><input type="hidden" name="orderId" value="${selectedOrder.po_id}">
                            <h3>Delete this unreceived order?</h3><p>The order and its listed purchase-order items will be deleted in one transaction. A deletion audit record will remain. No receipt or inventory rows will be changed.</p>
                            <div class="form-field"><label for="order-delete-reason">Reason (required)</label><input id="order-delete-reason" name="reason" type="text" maxlength="400" required></div>
                            <label class="confirmation-check"><input type="checkbox" name="confirm" value="yes" required><span>I reviewed order <strong><c:out value="${selectedOrder.po_number}" /></strong> and confirm this deletion.</span></label>
                            <div class="reference-form-actions"><button class="button button-danger" type="submit">Delete order</button></div>
                        </form>
                    </c:if>
                    <c:if test="${(selectedOrder.status eq 'OPEN' or selectedOrder.status eq 'PARTIAL')}">
                        <form class="delete-confirmation cleanup-action-form" action="${pageContext.request.contextPath}/admin/data-cleanup" method="post">
                            <input type="hidden" name="_csrf" value="<c:out value='${csrfToken}' />"><input type="hidden" name="section" value="<c:out value='${adminSection}' />"><input type="hidden" name="action" value="cancel-order"><input type="hidden" name="orderId" value="${selectedOrder.po_id}">
                            <h3>Cancel and preserve this order</h3><p>Cancellation changes an OPEN or PARTIAL order to CANCELLED and keeps its order, items, receipts, and audit history.</p>
                            <div class="form-field"><label for="order-cancel-reason">Reason (required)</label><input id="order-cancel-reason" name="reason" type="text" maxlength="400" required></div>
                            <label class="confirmation-check"><input type="checkbox" name="confirm" value="yes" required><span>I reviewed this order and confirm cancellation.</span></label>
                            <div class="reference-form-actions"><button class="button button-secondary" type="submit">Cancel order</button></div>
                        </form>
                    </c:if>
                    <c:if test="${not (selectedOrder.receipt_count eq 0 and selectedOrder.review_count eq 0 and selectedOrder.audit_count eq 0) and not (selectedOrder.status eq 'OPEN' or selectedOrder.status eq 'PARTIAL')}"><p class="notice notice-info">Hard deletion is blocked by the receipt, review, or audit history shown above. This status does not support cancellation. Keep this order as historical evidence.</p></c:if>
                </div>
            </c:when><c:when test="${not empty param.orderId}"><div class="notice notice-info" id="order-review">The selected purchase order does not exist or its ID is invalid.</div></c:when></c:choose>
        </section>

        </c:if>
        <c:if test="${adminSection eq 'receipts'}">
        <section class="panel admin-section" id="receipts" aria-labelledby="receipts-title" data-admin-search-scope>
            <div class="panel-heading"><div><p class="eyebrow">Receipt and ledger protection</p><h2 id="receipts-title">Goods receipts</h2></div></div>
            <p class="panel-note">A verified or inventory-processed receipt is never hard-deleted. If accepted stock was posted, a single transaction may add compensating ADJUSTMENT_OUT entries only when current balances can safely cover them. The source receipt and original RECEIPT ledger entries remain.</p>
            <div class="table-wrap"><table class="admin-table"><thead><tr><th>Receipt</th><th>Order</th><th>Vendor</th><th>Arrived</th><th>Verified</th><th>Inventory posted</th><th>Accepted qty</th><th>Rejected qty</th><th>Review</th></tr></thead><tbody><c:forEach items="${adminReceipts}" var="row"><tr><td>#<c:out value="${row.receipt_id}" /></td><td><c:out value="${row.po_number}" /></td><td><c:out value="${row.vendor_name}" /></td><td><fmt:formatDate value="${row.arrived_at}" pattern="yyyy-MM-dd HH:mm" /></td><td><c:choose><c:when test="${not empty row.verified_at}">Yes</c:when><c:otherwise>No</c:otherwise></c:choose></td><td><c:choose><c:when test="${not empty row.inventory_processed_at}">Yes</c:when><c:otherwise>No</c:otherwise></c:choose></td><td><c:out value="${row.accepted_qty}" /></td><td><c:out value="${row.rejected_qty}" /></td><td><a href="${pageContext.request.contextPath}/admin/data-cleanup?section=receipts&receiptId=${row.receipt_id}#receipt-review">Review record</a></td></tr></c:forEach><c:if test="${empty adminReceipts}"><tr><td colspan="9" class="empty-cell">No receipts match this search.</td></tr></c:if></tbody></table></div>
            <c:choose><c:when test="${not empty selectedReceipt}">
                <div class="admin-review-card" id="receipt-review"><div class="panel-heading"><div><p class="eyebrow">Selected receipt</p><h3>#<c:out value="${selectedReceipt.receipt_id}" /> · <c:out value="${selectedReceipt.po_number}" /></h3></div><span class="unit-tag"><c:out value="${selectedReceipt.vendor_name}" /></span></div>
                    <dl class="admin-detail-facts"><div><dt>Invoice reference</dt><dd><c:out value="${selectedReceipt.invoice_reference}" /></dd></div><div><dt>Invoice amount</dt><dd><fmt:formatNumber value="${selectedReceipt.invoice_amount}" minFractionDigits="2" maxFractionDigits="2" /></dd></div><div><dt>Verified at</dt><dd><c:choose><c:when test="${not empty selectedReceipt.verified_at}"><fmt:formatDate value="${selectedReceipt.verified_at}" pattern="yyyy-MM-dd HH:mm" /></c:when><c:otherwise>Not verified</c:otherwise></c:choose></dd></div><div><dt>Inventory processed</dt><dd><c:choose><c:when test="${not empty selectedReceipt.inventory_processed_at}"><fmt:formatDate value="${selectedReceipt.inventory_processed_at}" pattern="yyyy-MM-dd HH:mm" /></c:when><c:otherwise>No</c:otherwise></c:choose></dd></div><div><dt>Reversed</dt><dd><c:choose><c:when test="${selectedReceipt.reversed_flag eq 'Y'}">Yes</c:when><c:otherwise>No</c:otherwise></c:choose></dd></div></dl>
                    <div class="table-wrap"><table class="admin-table"><thead><tr><th>Ingredient</th><th>Received</th><th>Accepted</th><th>Rejected</th></tr></thead><tbody><c:forEach items="${selectedReceiptItems}" var="line"><tr><td><c:out value="${line.ingredient_name}" /> (<c:out value="${line.base_unit}" />)</td><td><c:out value="${line.received_qty}" /></td><td><c:out value="${line.accepted_qty}" /></td><td><c:out value="${line.rejected_qty}" /></td></tr></c:forEach></tbody></table></div>
                    <c:choose><c:when test="${not empty selectedReceipt.inventory_processed_at and selectedReceipt.reversed_flag ne 'Y'}"><form class="delete-confirmation cleanup-action-form" action="${pageContext.request.contextPath}/admin/data-cleanup" method="post"><input type="hidden" name="_csrf" value="<c:out value='${csrfToken}' />"><input type="hidden" name="section" value="<c:out value='${adminSection}' />"><input type="hidden" name="action" value="reverse-receipt"><input type="hidden" name="receiptId" value="${selectedReceipt.receipt_id}"><h3>Reverse posted stock with a compensating transaction</h3><p>Current balances are checked and locked. If stock has already been consumed below the receipt quantity, the entire reversal is rolled back. Original receipt evidence is never deleted.</p><div class="form-field"><label for="receipt-reversal-reason">Reason (required)</label><input id="receipt-reversal-reason" name="reason" type="text" maxlength="400" required></div><label class="confirmation-check"><input type="checkbox" name="confirm" value="yes" required><span>I reviewed the receipt lines and confirm this stock reversal.</span></label><div class="reference-form-actions"><button class="button button-danger" type="submit">Record inventory reversal</button></div></form></c:when>
                    <c:when test="${selectedReceipt.reversed_flag eq 'Y'}"><p class="notice notice-info">A reversal is already recorded. Duplicate reversal is blocked; the receipt and its ledger history remain.</p></c:when>
                    <c:when test="${empty selectedReceipt.verified_at and empty selectedReceipt.inventory_processed_at}"><form class="delete-confirmation cleanup-action-form" action="${pageContext.request.contextPath}/admin/data-cleanup" method="post"><input type="hidden" name="_csrf" value="<c:out value='${csrfToken}' />"><input type="hidden" name="section" value="<c:out value='${adminSection}' />"><input type="hidden" name="action" value="delete-receipt"><input type="hidden" name="receiptId" value="${selectedReceipt.receipt_id}"><h3>Delete this unverified receipt?</h3><p>This operation is allowed only while the receipt is unverified, unprocessed, and no inventory ledger row references its items. Receipt and item rows are deleted together; a deletion audit row remains.</p><div class="form-field"><label for="receipt-delete-reason">Reason (required)</label><input id="receipt-delete-reason" name="reason" type="text" maxlength="400" required></div><label class="confirmation-check"><input type="checkbox" name="confirm" value="yes" required><span>I reviewed receipt #<c:out value="${selectedReceipt.receipt_id}" /> and confirm deletion.</span></label><div class="reference-form-actions"><button class="button button-danger" type="submit">Delete unverified receipt</button></div></form></c:when>
                    <c:otherwise><p class="notice notice-info">This receipt is not eligible for hard deletion. Keep its evidence and review the application workflow before taking further action.</p></c:otherwise></c:choose>
                </div>
            </c:when><c:when test="${not empty param.receiptId}"><div class="notice notice-info" id="receipt-review">The selected goods receipt does not exist or its ID is invalid.</div></c:when></c:choose>
        </section>

        </c:if>
        <c:if test="${adminSection eq 'daily'}">
        <section class="panel admin-section" id="daily-records" aria-labelledby="daily-title" data-admin-search-scope>
            <div class="panel-heading"><div><p class="eyebrow">Measured operations</p><h2 id="daily-title">Daily mess records</h2></div></div>
            <p class="panel-note">Daily records have no dependent operational rows in the current schema. Deletion still requires an explicit confirmation and writes an audit record. NULL measurements remain NULL.</p>
            <div class="table-wrap"><table class="admin-table"><thead><tr><th>Record</th><th>Date</th><th>Mess block</th><th>Meals served</th><th>Prepared kg</th><th>Measured leftovers kg</th><th>Review</th></tr></thead><tbody><c:forEach items="${adminDailyRecords}" var="row"><tr><td>#<c:out value="${row.record_id}" /></td><td><fmt:formatDate value="${row.record_date}" pattern="yyyy-MM-dd" /></td><td><c:out value="${row.block_name}" /></td><td><c:out value="${row.meals_served}" /></td><td><c:choose><c:when test="${not empty row.prepared_kg}"><c:out value="${row.prepared_kg}" /></c:when><c:otherwise>NULL</c:otherwise></c:choose></td><td><c:choose><c:when test="${not empty row.leftover_kg}"><c:out value="${row.leftover_kg}" /></c:when><c:otherwise>NULL</c:otherwise></c:choose></td><td><a href="${pageContext.request.contextPath}/admin/data-cleanup?section=daily&recordId=${row.record_id}#daily-review">Review record</a></td></tr></c:forEach><c:if test="${empty adminDailyRecords}"><tr><td colspan="7" class="empty-cell">No daily records match this search.</td></tr></c:if></tbody></table></div>
            <c:choose><c:when test="${not empty selectedDailyRecord}"><div class="admin-review-card" id="daily-review"><div class="panel-heading"><div><p class="eyebrow">Selected record</p><h3>Daily record #<c:out value="${selectedDailyRecord.record_id}" /></h3></div><a href="${pageContext.request.contextPath}/admin/data-management?section=daily&recordId=${selectedDailyRecord.record_id}#daily-form">Edit record</a></div><dl class="admin-detail-facts"><div><dt>Block ID</dt><dd><c:out value="${selectedDailyRecord.block_id}" /></dd></div><div><dt>Date</dt><dd><fmt:formatDate value="${selectedDailyRecord.record_date}" pattern="yyyy-MM-dd" /></dd></div><div><dt>Meals served</dt><dd><c:out value="${selectedDailyRecord.meals_served}" /></dd></div><div><dt>Prepared kg</dt><dd><c:out value="${selectedDailyRecord.prepared_kg}" /></dd></div><div><dt>Measured leftovers kg</dt><dd><c:out value="${selectedDailyRecord.leftover_kg}" /></dd></div><div><dt>Measurement method</dt><dd><c:out value="${selectedDailyRecord.measurement_method}" /></dd></div></dl><form class="delete-confirmation cleanup-action-form" action="${pageContext.request.contextPath}/admin/data-cleanup" method="post"><input type="hidden" name="_csrf" value="<c:out value='${csrfToken}' />"><input type="hidden" name="section" value="<c:out value='${adminSection}' />"><input type="hidden" name="action" value="delete-daily"><input type="hidden" name="recordId" value="${selectedDailyRecord.record_id}"><h3>Delete this daily mess record?</h3><p>The row is removed and a concise deletion audit entry is preserved. No measurement will be changed to zero or treated as disposal evidence.</p><label class="confirmation-check"><input type="checkbox" name="confirm" value="yes" required><span>I reviewed daily record #<c:out value="${selectedDailyRecord.record_id}" /> and confirm deletion.</span></label><div class="reference-form-actions"><button class="button button-danger" type="submit">Delete daily record</button></div></form></div></c:when><c:when test="${not empty param.recordId}"><div class="notice notice-info" id="daily-review">The selected daily record does not exist or its ID is invalid.</div></c:when></c:choose>
        </section>
        </c:if>
    </main>
    <script src="${pageContext.request.contextPath}/js/admin-data-filter.js?v=20261029-focused" defer></script>
</body>
</html>
