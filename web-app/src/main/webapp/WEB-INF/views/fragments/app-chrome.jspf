    <header class="site-header">
        <a class="brand" href="${pageContext.request.contextPath}/dashboard" aria-label="MessAudit dashboard">
            <span class="brand-mark" aria-hidden="true">M</span>
            <span class="brand-copy">
                <span class="brand-title">MessAudit</span>
                <span class="brand-subtitle">Procurement &amp; Operations Management</span>
            </span>
        </a>
        <a class="public-home-link" href="${pageContext.request.contextPath}/" aria-label="MessAudit public home">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m3.5 10 8.5-7 8.5 7v10.5h-6v-6h-5v6h-6z" /></svg>
            <span>Home</span>
        </a>
        <c:if test="${not empty authenticatedUser}">
            <a class="identity-chip" href="${pageContext.request.contextPath}/profile"
               aria-current="${activeRoute eq '/profile' ? 'page' : 'false'}" aria-label="My profile">
                <span class="identity-name"><strong><c:out value="${headerDisplayName}" /></strong><small>Signed in</small></span>
                <span class="identity-role-badge"><c:choose><c:when test="${canManage}">Admin</c:when><c:otherwise>User</c:otherwise></c:choose></span>
            </a>
        </c:if>
        <form class="header-logout-form" action="${pageContext.request.contextPath}/logout" method="post">
            <input type="hidden" name="_csrf" value="<c:out value='${csrfToken}' />">
            <button class="button button-secondary header-logout-button" type="submit">Sign out</button>
        </form>
        <c:if test="${canManage}">
            <a class="status-link db-status-link" href="${pageContext.request.contextPath}/database-status"
               data-status-url="${pageContext.request.contextPath}/database-status/indicator"
               aria-current="${activeRoute eq '/database-status' or activeRoute eq '/database-status/check' ? 'page' : 'false'}"
               aria-label="Database status" aria-live="polite">
                <span class="status-link-dot" data-db-status-dot aria-hidden="true"></span>
                <span data-db-status-label>Checking status</span>
            </a>
        </c:if>
        <script src="${pageContext.request.contextPath}/js/database-status-indicator.js?v=20261028-1" defer></script>
    </header>

    <nav class="primary-nav" aria-label="Main navigation">
        <details class="navigation-disclosure" open>
            <summary class="navigation-toggle">
                <span>Workspace</span>
                <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="m5 7.5 5 5 5-5"/></svg>
            </summary>
            <ul class="navigation-list">
                <li>
                    <a href="${pageContext.request.contextPath}/dashboard"
                       aria-current="${activeRoute eq '/dashboard' ? 'page' : 'false'}">
                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3.5" y="3.5" width="7" height="7" rx="1.4"/><rect x="13.5" y="3.5" width="7" height="5" rx="1.4"/><rect x="13.5" y="10.5" width="7" height="10" rx="1.4"/><rect x="3.5" y="12.5" width="7" height="8" rx="1.4"/></svg>
                        <span>Dashboard</span>
                    </a>
                </li>
                <li>
                    <a href="${pageContext.request.contextPath}/procurement"
                       aria-current="${activeRoute eq '/procurement' ? 'page' : 'false'}">
                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 5.5h2l2.1 10.1a1.7 1.7 0 0 0 1.7 1.4h7.6a1.7 1.7 0 0 0 1.7-1.3L21 9H7"/><circle cx="10" cy="20" r="1.3"/><circle cx="17.5" cy="20" r="1.3"/></svg>
                        <span>Procurement</span>
                    </a>
                </li>
                <li>
                    <a href="${pageContext.request.contextPath}/goods-receipts"
                       aria-current="${activeRoute eq '/goods-receipts' ? 'page' : 'false'}">
                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m12 3.5 8 4.2v8.6l-8 4.2-8-4.2V7.7z"/><path d="m4.2 7.8 7.8 4.1 7.8-4.1M12 12v8.3M8 5.6l8 4.2"/></svg>
                        <span>Goods Receipt</span>
                    </a>
                </li>
                <li>
                    <a href="${pageContext.request.contextPath}/inventory"
                       aria-current="${activeRoute eq '/inventory' ? 'page' : 'false'}">
                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m4 7 8-4 8 4-8 4zM4 7v10l8 4 8-4V7M12 11v10M8 5l8 4"/></svg>
                        <span>Inventory</span>
                    </a>
                </li>
                <li>
                    <a href="${pageContext.request.contextPath}/food-wastage"
                       aria-current="${activeRoute eq '/food-wastage' ? 'page' : 'false'}">
                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="8.5"/><path d="M12 7v5l3.4 2M8 3.8l-1.4-1M16 3.8l1.4-1"/></svg>
                        <span>Wastage &amp; meals</span>
                    </a>
                </li>
                <li>
                    <a href="${pageContext.request.contextPath}/vendor-audit"
                       aria-current="${activeRoute eq '/vendor-audit' ? 'page' : 'false'}">
                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 4.5h8a2 2 0 0 1 2 2v13H6v-13a2 2 0 0 1 2-2Z"/><path d="M9 4.5v-1h6v1M9 11l2 2 4-4M9 17h6"/></svg>
                        <span>Vendor audit</span>
                    </a>
                </li>
                <li>
                    <a href="${pageContext.request.contextPath}/vendors"
                       aria-current="${activeRoute eq '/vendors' ? 'page' : 'false'}">
                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="9" cy="8" r="3"/><path d="M3.5 19v-1.5a5.5 5.5 0 0 1 11 0V19zM16 5.5a3 3 0 0 1 0 5.8M17 14a4.5 4.5 0 0 1 3.5 4.4V19"/></svg>
                        <span>Vendors</span>
                    </a>
                </li>
                <li>
                    <a href="${pageContext.request.contextPath}/ingredients"
                       aria-current="${activeRoute eq '/ingredients' ? 'page' : 'false'}">
                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 20V9M12 12C6 12 4 9 4 5c5 0 8 2 8 7ZM12 15c6 0 8-3 8-7-5 0-8 2-8 7Z"/></svg>
                        <span>Ingredients</span>
                    </a>
                </li>
                <li>
                    <a href="${pageContext.request.contextPath}/mess-blocks"
                       aria-current="${activeRoute eq '/mess-blocks' ? 'page' : 'false'}">
                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 20V7l8-4 8 4v13M2.5 20h19M8 10h2M14 10h2M8 14h2M14 14h2M10 20v-3h4v3"/></svg>
                        <span>Mess blocks</span>
                    </a>
                </li>
                <c:if test="${canManage}">
                    <li class="navigation-section-label"><span>Administration</span></li>
                    <li>
                        <a href="${pageContext.request.contextPath}/admin/data-management"
                           aria-current="${activeRoute eq '/admin/data-management' ? 'page' : 'false'}">
                            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 3 19 6v5c0 4.7-2.9 8-7 10-4.1-2-7-5.3-7-10V6z"/><path d="m9 12 2 2 4-4"/></svg>
                            <span>Admin data management</span>
                        </a>
                    </li>
                    <li>
                        <a href="${pageContext.request.contextPath}/admin/data-cleanup"
                           aria-current="${activeRoute eq '/admin/data-cleanup' ? 'page' : 'false'}">
                            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 7h16M9 7V4h6v3m-9 0 1 13h10l1-13M10 11v5m4-5v5"/></svg>
                            <span>Admin data cleanup</span>
                        </a>
                    </li>
                </c:if>
            </ul>
        </details>
        <p class="nav-caption">Procurement &amp; operations</p>
    </nav>
